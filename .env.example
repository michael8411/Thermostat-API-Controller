# Copy to .env and fill in. Never commit .env.
# Every variable uses the NEST_ prefix.

# OAuth 2.0 Client ID and secret from Google Cloud Console > APIs & Services > Credentials.
NEST_OAUTH_CLIENT_ID=
NEST_OAUTH_CLIENT_SECRET=

# Device Access project ID from https://console.nest.google.com/device-access
# This is a UUID. It is NOT your Google Cloud project ID.
NEST_DEVICE_ACCESS_PROJECT_ID=

# Must match an authorized redirect URI on the OAuth client. The SDM guide uses https://www.google.com
NEST_REDIRECT_URI=https://www.google.com

# Optional seed. The refresh token belongs in the TokenStore, which
# `uv run nest-auth exchange <code>` writes. Set this only when the store is
# empty (first run before a persistent store exists, CI, a container).
# It is a secret: never commit it.
NEST_REFRESH_TOKEN=

# Optional: the device ID (last path segment of enterprises/.../devices/<id>) to use by default.
NEST_DEFAULT_DEVICE_ID=

# Optional: Google Cloud project ID. Only needed later for Pub/Sub events. Not used today.
NEST_GCP_PROJECT_ID=
